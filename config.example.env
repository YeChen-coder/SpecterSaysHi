# Copy to config.local.env, then set the exact Face Library name for yourself.
SPECTER_TARGET_NAME=
SPECTER_CAMERA_NAME=desk_camera
SPECTER_MQTT_HOST=127.0.0.1
SPECTER_MQTT_PORT=1884
# EN: Enable the phone signal bridge. LAN uses pinned TLS on port 18766;
# USB loopback on port 18765 remains available for initial setup and diagnostics.
# 中文：手机信号桥接默认支持加密局域网连接；USB 仅用于首次安装或诊断。
SPECTER_PHONE_LINK_ENABLED=false
SPECTER_PHONE_LAN_ENABLED=true
SPECTER_PHONE_LAN_PORT=18766
SPECTER_MIN_FACE_SCORE=0.90
SPECTER_MIN_PERSON_AREA=40000
# EN: Camera arrival starts a greeting only when enabled; manual start still works.
# 中文：仅控制摄像头到场时的主动问候；关闭后仍可手动开启对话。
SPECTER_PROACTIVE_GREETING_ENABLED=true
# EN: Human greeting: time away before a new visit, then minimum time between greetings.
# 中文：人脸问候：离开多久才算新的一次到来；两次问候至少间隔多久。
SPECTER_ABSENCE_SECONDS=25
SPECTER_COOLDOWN_SECONDS=90
# EN: Close an inactive conversation after 5 minutes; cap its total life at 45 minutes.
# 中文：连续空闲 5 分钟关闭对话；从会话开始算起，最多运行 45 分钟。
SPECTER_SESSION_IDLE_SECONDS=300
SPECTER_SESSION_MAX_SECONDS=2700
SPECTER_TRACE_ENABLED=false
SPECTER_LOG_TRANSCRIPTS=false
SPECTER_MEMORY_MODEL=gpt-5.4-mini
SPECTER_MEMORY_TIMEOUT_SECONDS=45
SPECTER_LONG_TERM_MEMORY_MODEL=gpt-6-sol
SPECTER_LONG_TERM_MEMORY_TIMEOUT_SECONDS=120
SPECTER_MEMORY_CONSOLIDATION_HOURS=24
SPECTER_REALTIME_MEMORY_MAX_CHARS=6000
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false
SPECTER_MIC_NAME=
SPECTER_SPEAKER_NAME=
# EN: Legacy mini settings. The project-root .env selects the avatar backend and enable flag.
# 中文：旧版 mini 设置；项目根目录 .env 统一选择数字人后端及同步开关。
SPECTER_MINI_ENABLED=false
SPECTER_MINI_WS_URL=ws://127.0.0.1:18888/publish
# EN: Set SPECTER_AVATAR_BACKEND=feathertalk or dh_live in the project-root .env.
# SPECTER_AVATAR_ENABLED takes precedence over legacy enable flags.
# For DH_live, SPECTER_DH_LIVE_MODEL selects mini/full. Specter and Docker share .env.
# For FeatherTalk, configure SPECTER_FEATHERTALK_MODE/BUFFER_MS/TEETH_MODE there too.
# SPECTER_FEATHERTALK_SETTLE_MS controls the mouth-to-idle easing (default 320 ms).
# SPECTER_FEATHERTALK_DETAIL_PROFILE=model_idle uses the reviewed chin/clarity updates; original reverts appearance.
# 中文：项目根目录 .env 的 SPECTER_AVATAR_BACKEND 选择 feathertalk 或 dh_live；
# SPECTER_AVATAR_ENABLED 优先于旧同步开关；DH_live 仍可选择 mini/full。
# FeatherTalk 档位、缓冲和牙齿修复也在同一 .env 设置，语音监听器与 Docker 共用。
# SPECTER_FEATHERTALK_SETTLE_MS 控制说话后嘴部回到待机的平滑过渡，默认 320 毫秒。
# SPECTER_FEATHERTALK_DETAIL_PROFILE=model_idle 使用已确认的下巴与清晰度改动；original 回退外观。
# SPECTER_DH_LIVE_BUFFER_MS=100 控制推理前累积音频的毫秒数；
# SPECTER_DH_LIVE_ENABLED 是兼容旧配置的开关，优先于 SPECTER_MINI_ENABLED。
# 中文：完整版口腔细节：SPECTER_DH_LIVE_TEETH_MODE=source 使用同人物原素材牙齿，model 使用模型原输出；
# SPECTER_DH_LIVE_TEETH_STRENGTH=0.85 控制补偿强度（0~1）；SPECTER_DH_LIVE_JPEG_QUALITY=95 控制画质（1~100）。
# SPECTER_DH_LIVE_SETTLE_MS=320 控制完整版说话结束后的收口过渡（80~1000 ms），不增加语音起播缓冲。
# EN: Full model only: teeth mode source/model, restoration strength 0..1, JPEG quality 1..100.
SPECTER_BARGE_IN_ENABLED=true
SPECTER_AEC_ENABLED=true
SPECTER_AEC_DELAY_MS=0
SPECTER_AEC_WARMUP_MS=500
# far_field suits a camera/conference microphone; near_field suits a close headset mic.
SPECTER_SERVER_NOISE_REDUCTION=far_field
REALTIME_VAD_THRESHOLD=0.65
# EN: Server VAD speech segmentation for the human Realtime conversation (milliseconds).
# 中文：人类 Realtime 对话的服务端 VAD 语音分段时间，单位为毫秒。
SPECTER_VAD_PREFIX_PADDING_MS=300
SPECTER_VAD_SILENCE_DURATION_MS=650
SPECTER_VISUAL_ENABLED=true
# EN: FOCI may proactively start a separate check-in session when enabled.
# 中文：开启时 FOCI 状态可主动触发独立的关怀会话。
SPECTER_FOCI_ENABLED=false
# EN: Local read-only FOCI dashboard address used by Specter.
# 中文：Specter 读取 FOCI 仪表盘的本地地址。
SPECTER_FOCI_URL=http://127.0.0.1:8765
# EN: Seconds to wait for a reply to an initial FOCI check-in before closing that voice session.
# 中文：FOCI 主动关怀开场后，等待用户回应的秒数；超时则结束这次语音会话。
SPECTER_FOCI_SESSION_IDLE_SECONDS=15
# EN: FOCI publishes live data for this many seconds per cycle. Keep it above the minimum evaluation duration.
# 中文：每轮连续采集实时数据的秒数；应大于下方的最短评估时长。
FOCI_STREAM_ON_SECONDS=90
# EN: FOCI pauses live notifications for this many seconds; 0 disables the pause cycle.
# 中文：每轮停止实时数据通知的秒数；设为 0 可关闭间歇模式。
FOCI_STREAM_OFF_SECONDS=90
# EN: State labels counted as adverse; comma-separated names from the dashboard.
# 中文：计入不佳状态的标签，使用仪表盘的英文标签并以逗号分隔。
SPECTER_FOCI_ADVERSE_STATES=distracted,stressed,fatigued
# EN: State labels that can reset the trigger after recovery; comma-separated.
# 中文：持续出现后可让提醒重新待命的恢复状态，以逗号分隔。
SPECTER_FOCI_RECOVERED_STATES=calm,focused,flow
# EN: Allow this many seconds of clock skew when a sample timestamp is in the future.
# 中文：样本时间比电脑时间超前时，允许的时钟误差秒数。
SPECTER_FOCI_FUTURE_TOLERANCE_SECONDS=2
# EN: Reject a sample older than this many seconds and clear the evaluation window.
# 中文：样本超过这个秒数仍未到达，就视为过期并清空评估窗口。
SPECTER_FOCI_MAX_SAMPLE_AGE_SECONDS=5
# EN: Clear the evaluation window if consecutive sample timestamps are farther apart.
# 中文：两条样本时间间隔超过这个秒数时，清空评估窗口。
SPECTER_FOCI_MAX_SAMPLE_GAP_SECONDS=5
# EN: Keep only this many seconds of recent samples for the adverse-state ratio.
# 中文：计算不佳状态比例时，只保留最近这么多秒的样本。
SPECTER_FOCI_WINDOW_SECONDS=90
# EN: Require at least this many new samples before a check-in can trigger.
# 中文：触发关怀提醒前，至少需要这么多条新样本。
SPECTER_FOCI_MIN_SAMPLES=30
# EN: Require samples to span at least this many continuous seconds.
# 中文：新样本至少要连续覆盖这么多秒，才可能触发。
SPECTER_FOCI_MIN_DURATION_SECONDS=60
# EN: Minimum fraction of adverse labels in the evaluation window (0 to 1).
# 中文：评估窗口内不佳状态的最低占比，范围为 0 到 1。
SPECTER_FOCI_MIN_ADVERSE_FRACTION=0.70
# EN: At or above this fraction, focus depth is no longer required as supporting evidence.
# 中文：不佳状态占比达到此值时，不再要求专注深度作额外佐证。
SPECTER_FOCI_STRONG_ADVERSE_FRACTION=0.85
# EN: Below the strong fraction, mean adverse-sample focus depth must be at most this value.
# 中文：占比未达到上方强阈值时，不佳样本的平均专注深度须不高于此值。
SPECTER_FOCI_MAX_MEAN_FOCUS_DEPTH=65
# EN: After a trigger, require this many seconds of recovered states before rearming.
# 中文：触发一次后，恢复状态须持续这么多秒，才允许下一次提醒。
SPECTER_FOCI_RECOVERY_SECONDS=30
# EN: Lowest focus-depth value accepted as valid input; dashboard scale is 0 to 100.
# 中文：可用于评估的专注深度下限；仪表盘量表范围是 0 到 100。
SPECTER_FOCI_MIN_VALID_FOCUS_DEPTH=0
# EN: Highest focus-depth value accepted as valid input; dashboard scale is 0 to 100.
# 中文：可用于评估的专注深度上限；仪表盘量表范围是 0 到 100。
SPECTER_FOCI_MAX_VALID_FOCUS_DEPTH=100
# EN: Restart the FOCI dashboard after changing FOCI_STREAM_*; restart Specter after changing SPECTER_FOCI_*.
# 中文：修改 FOCI_STREAM_* 后重启 FOCI 仪表盘；修改 SPECTER_FOCI_* 后重启 Specter。
SPECTER_FRIGATE_URL=http://127.0.0.1:15000
SPECTER_IMAGE_WIDTH=768
SPECTER_IMAGE_QUALITY=75
SPECTER_CAT_ALERT_ENABLED=false
SPECTER_CAT_PLAY_AUDIO=true
SPECTER_CAT_REFERENCE_DIR=private\cats\Tabo
SPECTER_CAT_CHICHI_REFERENCE_DIR=private\cats\chichi
SPECTER_CAT_CLASSIFIER_MODEL=household_cats
SPECTER_CAT_VISION_MODEL=gpt-5.4-mini
SPECTER_CAT_TTS_MODEL=gpt-4o-mini-tts
SPECTER_CAT_TTS_VOICE=sage
SPECTER_CAT_MIN_AREA=8000
SPECTER_CAT_TILE_ENABLED=true
SPECTER_CAT_TILE_MIN_SCORE=0.55
SPECTER_CAT_SCAN_INTERVAL_SECONDS=2
SPECTER_CAT_COOLDOWN_SECONDS=300
SPECTER_CAT_ABSENCE_SECONDS=30
SPECTER_FFMPEG_PATH=
SPECTER_DSHOW_CAMERA_NAME=YOUR_DIRECTSHOW_CAMERA_NAME
# Existing EBO .env is read only at runtime for OPENAI_API_KEY and Realtime settings.
SPECTER_EXISTING_ENV=
