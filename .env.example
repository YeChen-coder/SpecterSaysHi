# EN: Copy this file to .env in the project root.
# 中文：复制此文件为项目根目录的 .env。
# EN: Per web-research attempt; up to 3 attempts with 0.5s / 1s retry delays.
# 中文：每次网页研究尝试的超时秒数；最多 3 次，重试间隔 0.5 秒 / 1 秒。
SPECTER_RESEARCH_TIMEOUT_SECONDS=15
# EN: Mirror played Realtime audio to the selected avatar. Restart the voice listener after editing.
# 中文：将实际播放的 Realtime 音频同步给下方选择的数字人；修改后重启语音监听器。
SPECTER_AVATAR_ENABLED=false
# EN: Avatar backend: feathertalk or dh_live. DH_live remains installed.
# 中文：数字人后端：feathertalk 或 dh_live；DH_live 的服务和素材继续保留。
SPECTER_AVATAR_BACKEND=feathertalk

# EN: FeatherTalk Realtime publisher URL; open http://127.0.0.1:18988/ to view the avatar.
# 中文：FeatherTalk 实时音频发布地址；在 http://127.0.0.1:18988/ 查看数字人。
SPECTER_FEATHERTALK_WS_URL=ws://127.0.0.1:18988/publish
# EN: fast = no extra future buffer; balanced = 400 ms; quality = 1000 ms (no quality guarantee).
# 中文：fast 无额外未来帧缓冲；balanced 增加 400 ms；quality 增加 1000 ms（不保证画质更好）。
SPECTER_FEATHERTALK_MODE=fast
# EN: PCM accumulated before inference, 40..1000 ms; independent of the mode's future buffer.
# 中文：推理前累积音频的时间，40~1000 毫秒；与上方档位的未来帧缓冲独立。
SPECTER_FEATHERTALK_BUFFER_MS=100
# EN: new = configured teeth restoration from new speech footage; model = original model output.
# 中文：new 使用已配置的新说话素材牙齿修复；model 使用模型原始牙齿。
SPECTER_FEATHERTALK_TEETH_MODE=model
# EN: Ease the mouth back to the moving idle base after speech, 80..1000 ms; adds no audio startup buffer.
# 中文：说话结束后，嘴部平滑回到运动中的待机底片，80~1000 毫秒；不增加语音起播缓冲。
SPECTER_FEATHERTALK_SETTLE_MS=320
# EN: model_idle = reviewed matched-idle chin + local speech sharpening; original = previous appearance.
# 中文：model_idle 使用已确认的待机下巴匹配与说话局部锐化；original 回到之前的外观。
SPECTER_FEATHERTALK_DETAIL_PROFILE=original

# EN: Legacy DH_live enable flag; SPECTER_AVATAR_ENABLED takes precedence for both backends.
# 中文：旧 DH_live 同步开关；上方 SPECTER_AVATAR_ENABLED 优先控制两种后端。
SPECTER_DH_LIVE_ENABLED=true
# EN: With backend=dh_live, select full (port 18890) or mini (port 18888).
# 中文：后端为 dh_live 时选择 full（18890 端口）或 mini（18888 端口）。
SPECTER_DH_LIVE_MODEL=full
# EN: DH_live audio accumulated before inference, 40..1000 milliseconds.
# 中文：DH_live 推理前累积音频的时间，40~1000 毫秒。
SPECTER_DH_LIVE_BUFFER_MS=100
# EN: Full model teeth: source restores this person's source teeth; model uses the raw output.
# 中文：完整版牙齿：source 使用同人物原素材修复；model 使用模型原始输出。
SPECTER_DH_LIVE_TEETH_MODE=model
# EN: Full model teeth restoration strength, 0..1.
# 中文：完整版牙齿修复强度，0~1。
SPECTER_DH_LIVE_TEETH_STRENGTH=1.0
# EN: Full model JPEG quality, 1..100.
# 中文：完整版 JPEG 画质，1~100。
SPECTER_DH_LIVE_JPEG_QUALITY=95

# EN: Full avatar visual settling after speech, 80..1000 ms; independent of audio buffering.
# 中文：完整版说话后的收口过渡，80~1000 毫秒；与音频缓冲独立。
SPECTER_DH_LIVE_SETTLE_MS=320
